PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/cinemax
JWT_SECRET=replace-this-with-a-long-random-string

# Only used by `npm run create-admin` to create the first administrator.
# Uncomment and choose your own values (password: at least 8 characters). Never commit real ones.
# ADMIN_NAME=Administrator
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-long-password

# Sessions and security. All optional; the defaults are shown.
# SESSION_HOURS=2                      # how long a login lasts (there is no refresh token)
# ALLOWED_ORIGINS=http://localhost:3000   # comma-separated browser origins; REQUIRED in production (the Vercel address of the frontend)
# LOGIN_RATE_MAX=5                     # failed logins per IP+email before a 429
# LOGIN_RATE_WINDOW_MINUTES=15
# PAYMENT_REQUIRED=true                # false: bookings confirm at once, with no payment step
# HOLD_MINUTES=5                       # how long seats are held while the customer pays
# PAYMENT_DELAY_MS=900                 # pretend processing time of the simulated gateway
# COOKIE_SECURE=true                   # defaults to true when NODE_ENV=production (needs HTTPS)
# TRUST_PROXY=1                        # set behind a reverse proxy such as Render or Railway
# DNS_SERVERS=1.1.1.1,8.8.8.8          # use when "querySrv ECONNREFUSED" stops the server reaching Atlas

# Emails (booking confirmations, cancellations, reminders...). All optional. Without a key, emails are
# only saved as files in server/.mail-outbox (development) or logged, so nothing breaks. See docs/DEPLOY.md.
# BREVO_API_KEY=                       # recommended: free, sends over HTTPS (works on Render's free plan)
# RESEND_API_KEY=                      # alternative provider
# MAIL_FROM=you@example.com            # sender address; Brevo needs it verified in your Brevo account
# MAIL_FROM_NAME=filme                 # the sender name customers see
# APP_URL=https://your-site.vercel.app # the website's address, used for buttons and the logo in emails
# REMINDER_HOURS=3                     # how long before a showing the reminder is sent
# CRON_SECRET=                         # 16+ characters; lets a scheduler wake the server and send reminders (docs/DEPLOY.md)
# RELEASE_REMINDER_DAYS=1              # how many days before a coming-soon movie opens its "remind me" email is sent

# Production only (set these in your host's dashboard, not in a committed file). See docs/DEPLOY.md.
# NODE_ENV=production                  # refuses a short JWT_SECRET; secure cookies on by default
# CLIENT_DIST=                         # only if this server should also serve a built website; the frontend normally runs on Vercel

# Getting back into an account. All optional.
# RESET_MINUTES=60                     # how long a forgot-password link works
# LOGIN_CODE_MINUTES=10                # how long an emailed sign-in code works
# VERIFY_AFTER_DAYS=30                 # an account away this long needs a code emailed to it at its next sign-in (0 = off)
