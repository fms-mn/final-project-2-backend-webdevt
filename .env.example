PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/cinemax
JWT_SECRET=replace-this-with-a-long-random-string

# Only used by `npm run create-admin` to create the first administrator.
# Uncomment and choose your own values (password: at least 8 characters). Never commit real ones.
# ADMIN_NAME=Administrator
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-long-password

# Sessions and security. All optional; the defaults are shown.
# SESSION_HOURS=2                      # how long a login lasts (there is no refresh token)
# ALLOWED_ORIGINS=http://localhost:3000   # comma-separated browser origins; REQUIRED in production
# LOGIN_RATE_MAX=5                     # failed logins per IP+email before a 429
# LOGIN_RATE_WINDOW_MINUTES=15
# COOKIE_SECURE=true                   # defaults to true when NODE_ENV=production (needs HTTPS)
# TRUST_PROXY=1                        # set behind a reverse proxy such as Render or Railway

# Production only (set these in your host's dashboard, not in a committed file). See docs/DEPLOY.md.
# NODE_ENV=production                  # refuses a short JWT_SECRET; secure cookies on by default
# CLIENT_DIST=                         # where the built website is (defaults to ../client/dist)
